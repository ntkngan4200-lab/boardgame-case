# Hostinger (Apache/LiteSpeed): web là single-page app, mọi đường dẫn như /p1/truy-cap đều do React Router xử lý.
# Đường dẫn không trỏ tới file hay thư mục có thật thì trả về index.html thay vì trang 404 của máy chủ.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  # File build (JS/CSS/ảnh) bị thiếu thì vẫn báo 404 thật, không trả nhầm trang HTML
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteRule . /index.html [L]
</IfModule>
